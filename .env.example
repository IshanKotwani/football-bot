# Which backend to talk to: sarvam or aicredits.
PROVIDER=aicredits

# AICredits gateway — reseller fronting Anthropic's models.
# Same key as D:\Projects\multi-agent-pipeline\.env
ANTHROPIC_API_KEY=

# Sarvam AI — Indian provider, INR prepaid credits, no card needed to start.
# Key from https://dashboard.sarvam.ai (format: sk_xxx)
SARVAM_API_KEY=

# Live football data — free forever, no card, 10 requests/minute.
# Register at https://www.football-data.org/client/register
# Without this the bot still runs; it just answers from memory instead.
FOOTBALL_DATA_TOKEN=

# Optional overrides. Defaults come from the PROVIDER entry in provider.js:
#   sarvam    -> sarvam-105b-conversations  @ https://api.sarvam.ai/v1
#   aicredits -> anthropic/claude-haiku-4-5 @ https://api.aicredits.in/v1
# MODEL=
# BASE_URL=
# MAX_TOKENS=
# PORT=3000
